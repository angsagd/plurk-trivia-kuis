# Salin menjadi .env (produksi) atau .env.dev (pengembangan). File .env* tidak boleh di-commit.

# Plurk: real | fake
PLURK_MODE=fake
PLURK_CONSUMER_KEY=
PLURK_CONSUMER_SECRET=
PLURK_ACCESS_TOKEN=
PLURK_ACCESS_SECRET=

# Aplikasi
APP_SECRET_KEY=ganti-dengan-string-acak-panjang
APP_TIMEZONE=Asia/Jakarta
DB_PATH=/app/data/kuis.db

# Khusus dev (kosongkan / 60 di produksi; ditolak bila PLURK_MODE=real)
# FAKE_NOW   : jam awal palsu WIB, mis. 2026-11-30T11:58
# TICK_SECONDS: detik nyata per tick; < 60 = jam palsu maju 1 menit per tick (dev: 5)
FAKE_NOW=
TICK_SECONDS=60

# Admin web: false hanya untuk dev tanpa HTTPS
COOKIE_SECURE=true

# Traefik (dipakai label di compose.prod.yml)
ADMIN_HOST=admin.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Notifikasi (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
