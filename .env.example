# Salin menjadi .env (produksi) atau .env.dev (pengembangan). File .env* tidak boleh di-commit.

# Plurk: real | fake
PLURK_MODE=fake
PLURK_CONSUMER_KEY=
PLURK_CONSUMER_SECRET=
PLURK_ACCESS_TOKEN=
PLURK_ACCESS_SECRET=

# Aplikasi
APP_SECRET_KEY=ganti-dengan-string-acak-panjang
APP_TIMEZONE=Asia/Jakarta
DB_PATH=/app/data/kuis.db

# Khusus dev (kosongkan di produksi)
FAKE_NOW=
TICK_SECONDS=60

# Traefik (dipakai label di compose.prod.yml)
ADMIN_HOST=admin.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_CERTRESOLVER=letsencrypt

# Notifikasi (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
